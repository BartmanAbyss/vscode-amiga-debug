-/* On the m68k all args are always pushed.  */
+/* If the PARM_DECL at position PARMNO in current_function_decl's argument
+   list carries an explicit asm("reg") register constraint, return the hard
+   register number.  Return -1 in all other cases.
+
+   This implements the caller/callee agreement for the AmigaOS register
+   parameter calling convention.  When a parameter has an asm() spec:
+     - (callee) it arrives in that register on function entry
+     - (caller) it is placed in that register before the call
+   with no stack slot in either direction.
+
+   Note: this works for the callee (function being compiled) side.
+   Outgoing calls to register-parameter functions still use the
+   existing inline-asm stub approach via the NDK headers.
+
+   The frame pointer (a5), stack pointer (sp), and the virtual arg
+   pointer are rejected to prevent silent frame corruption.  */
+
+static int
+m68k_get_parm_regno_at (int parmno)
+{
+  if (!current_function_decl)
+    return -1;
+  int i = 0;
+  for (const_tree parm = DECL_ARGUMENTS (current_function_decl);
+       parm; parm = DECL_CHAIN (parm), i++)
+    {
+      if (i != parmno)
+	continue;
+      if (TREE_CODE (parm) != PARM_DECL)
+	return -1;
+      if (!DECL_ASSEMBLER_NAME_SET_P (parm))
+	return -1;
+      /* DECL_ASSEMBLER_NAME requires a non-const tree.  */
+      const char *name =
+	IDENTIFIER_POINTER (DECL_ASSEMBLER_NAME (CONST_CAST_TREE (parm)));
+      if (!name || *name == '\0')
+	return -1;
+      int regno = decode_reg_name (name);
+      if (regno < 0 || regno >= FIRST_PSEUDO_REGISTER)
+	return -1;
+      if (regno == FRAME_POINTER_REGNUM
+	  || regno == STACK_POINTER_REGNUM
+	  || regno == ARG_POINTER_REGNUM)
+	return -1;
+      return regno;
+    }
+  return -1;
+}
+
+/* On the m68k, args are pushed on the stack unless the parameter
+   carries an explicit asm("reg") register constraint.  */
 
 static rtx
-m68k_function_arg (cumulative_args_t, const function_arg_info &)
+m68k_function_arg (cumulative_args_t cum_v, const function_arg_info &arg)
 {
+  CUMULATIVE_ARGS *cum = get_cumulative_args (cum_v);
+  int regno = m68k_get_parm_regno_at (cum->parmno);
+  if (regno >= 0)
+    return gen_rtx_REG (arg.mode, regno);
   return NULL_RTX;
 }
 
@@ -1479,7 +1533,12 @@
 {
   CUMULATIVE_ARGS *cum = get_cumulative_args (cum_v);
 
-  *cum += (arg.promoted_size_in_bytes () + 3) & ~3;
+  /* Register-constrained parameters consume no stack space.  */
+  if (m68k_get_parm_regno_at (cum->parmno) < 0)
+    cum->bytes += (arg.promoted_size_in_bytes () + 3) & ~3;
+
+  /* Always advance the parameter index.  */
+  cum->parmno++;
 }
 
