+/* If the parameter at index CUM->parmno of CUM->fndecl carries an
+   explicit asm("reg") register constraint, return the hard register
+   number.  Return -1 in all other cases.
+
+   This implements the caller/callee agreement for the AmigaOS register
+   parameter calling convention.  When a parameter has an asm() spec:
+     - (callee) it arrives in that register on function entry
+     - (caller) it is placed in that register before the call
+   with no stack slot in either direction.
+
+   Works on both sides: the callee prologue receives arguments in the
+   named registers, and same-translation-unit callers of an annotated
+   *definition* place arguments in those registers.  Annotated
+   prototypes (no definition visible) are rejected by the C front end
+   to prevent silent caller/callee ABI mismatches.
+
+   The frame pointer (a5), stack pointer (sp), and the virtual arg
+   pointer are rejected to prevent silent frame corruption.  */
+
+static int
+m68k_get_parm_regno (const CUMULATIVE_ARGS *cum)
+{
+  /* CUM->fndecl is the callee for outgoing calls and the current
+     function for incoming argument assignment.  The register map is
+     recorded by the C front end as an internal "m68k parm regs"
+     attribute on the FUNCTION_DECL of a *definition* (see
+     store_parm_decls in c-decl.cc); prototypes never carry it and
+     annotated prototypes are rejected outright, so returning -1
+     (stack ABI) here is always consistent between caller and callee.
+     DECL_ATTRIBUTES is used rather than the PARM_DECL chain because
+     cgraph frees DECL_ARGUMENTS once a function has been compiled,
+     which would make later callers fall back to the stack ABI.  */
+  if (!cum->fndecl || TREE_CODE (cum->fndecl) != FUNCTION_DECL)
+    return -1;
+  tree attr = lookup_attribute ("m68k parm regs",
+				DECL_ATTRIBUTES (cum->fndecl));
+  if (!attr)
+    return -1;
+  for (tree entry = TREE_VALUE (attr); entry; entry = TREE_CHAIN (entry))
+    {
+      if (!tree_fits_shwi_p (TREE_PURPOSE (entry))
+	  || tree_to_shwi (TREE_PURPOSE (entry)) != cum->parmno)
+	continue;
+      tree str = TREE_VALUE (entry);
+      if (!str || TREE_CODE (str) != STRING_CST)
+	return -1;
+      const char *name = TREE_STRING_POINTER (str);
+      if (!name || *name == '\0')
+	return -1;
+      int regno = decode_reg_name (name);
+      if (regno < 0 || regno >= FIRST_PSEUDO_REGISTER)
+	return -1;
+      if (regno == FRAME_POINTER_REGNUM
+	  || regno == STACK_POINTER_REGNUM
+	  || regno == ARG_POINTER_REGNUM)
+	return -1;
+      return regno;
+    }
+  return -1;
+}
