+   parameter index so that m68k_function_arg can look up the PARM_DECL
+   (and its optional asm("reg") constraint) by position in the parameter
+   list of current_function_decl.  */
+struct m68k_args {
+  int bytes;   /* stack bytes consumed by non-register args */
+  int parmno;  /* 0-based index of the next parameter to process */
+};
+#define CUMULATIVE_ARGS struct m68k_args
 
-/* On the m68k, the offset starts at 0.  */
+/* Initialise both fields to zero.  */
 #define INIT_CUMULATIVE_ARGS(CUM, FNTYPE, LIBNAME, INDIRECT, N_NAMED_ARGS) \
- ((CUM) = 0)
+ ((CUM).bytes = 0, (CUM).parmno = 0)
 
